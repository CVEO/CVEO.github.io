---
const { project } = Astro.props;

function getLevelColor(level: string) {
  switch (level) {
    case '国家级':
      return 'bg-brand-600 text-white border-brand-600';
    case '省部级':
      return 'bg-brand-100 text-brand-900 border-brand-200';
    case '社会服务':
      return 'bg-slate-50 text-slate-600 border-slate-200';
    default:
      return 'bg-slate-50 text-slate-700 border-slate-200';
  }
}

function getStatusColor(status: string) {
  switch (status) {
    case '在研':
      return 'bg-yellow-50 text-yellow-700 border-yellow-200';
    case '已结题':
      return 'bg-brand-green-50 text-brand-green-900 border-brand-green-200';
    default:
      return 'bg-slate-50 text-slate-700 border-slate-200';
  }
}
---
<div class="p-4 rounded-lg border border-slate-200 bg-white hover:shadow-md transition">
  <div class="flex justify-between items-start mb-4">
    <div class="flex-grow">
      <h3 class="text-lg font-semibold text-slate-900">{project.title}</h3>
      <p class="mt-2 text-slate-700">周期：{project.period}</p>
      {project.source && <p class="mt-1 text-slate-700">项目来源：{project.source}</p>}
    </div>
    <div class="flex flex-col gap-2 ml-4 flex-shrink-0">
      <span class={`inline-flex items-center justify-center px-3 py-1 rounded-full text-sm ${getLevelColor(project.level)} border`}>
        {project.level}
      </span>
      <span class={`inline-flex items-center justify-center px-3 py-1 rounded-full text-sm ${getStatusColor(project.status)} border`}>
        {project.status}
      </span>
    </div>
  </div>
</div>