---
import { Image } from 'astro:assets'
import { resolveImage } from '../lib/images'

interface Props {
  src: string;
  alt: string;
  aspectRatio?: string;
  className?: string;
  lazy?: boolean;
  fallbackSrc?: string;
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  aspectRatio = "1/1",
  className = "",
  lazy = true,
  fallbackSrc = "/assets/avatars/placeholder.svg",
  width,
  height
} = Astro.props;

const aspectRatioClass = {
  "3/4": "aspect-[3/4]",
  "1/1": "aspect-square",
  "4/3": "aspect-[4/3]",
  "16/9": "aspect-video"
}[aspectRatio] || "aspect-square";

// 去重类名，避免 html-validate no-dup-class 报错
const classes = [...new Set(["object-cover", "rounded", aspectRatioClass, ...className.split(/\s+/)])].join(" ");

// 构建期解析到真实文件则走优化管线；解析失败（路径笔误等）时回退并在构建期告警
const resolved = resolveImage(src) ?? resolveImage(fallbackSrc);
if (!resolved) {
  console.warn(`[AdaptiveImage] 无法解析图片路径: ${src}（fallback: ${fallbackSrc}）`);
}
---

{resolved ? (
  <Image
    src={resolved}
    alt={alt}
    class={classes}
    width={width ?? resolved.width}
    height={height ?? resolved.height}
    loading={lazy ? "lazy" : "eager"}
    decoding={lazy ? "async" : "auto"}
    format="webp"
  />
) : (
  <div class={`${classes} bg-slate-100 flex items-center justify-center text-slate-400 text-xs`} aria-label={alt}>
    {alt}
  </div>
)}
