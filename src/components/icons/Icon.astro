  console.warn(`[Icon] 未知图标名: ${name}`)
}
const paths = d ? (Array.isArray(d) ? d : [d]) : []
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={FILLED.has(name) ? 'currentColor' : 'none'}
  stroke={FILLED.has(name) ? 'none' : 'currentColor'}
  stroke-width={FILLED.has(name) ? undefined : strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {title && <title>{title}</title>}
  {paths.map(p => <path d={p} />)}
</svg>
