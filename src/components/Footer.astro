---
import Icon from './icons/Icon.astro'
import { Image } from 'astro:assets'
import { resolveImage } from '../lib/images'

const currentYear = new Date().getFullYear();
const cveoQr = resolveImage('/assets/social/wechat-cveo.png')
const luojiaQr = resolveImage('/assets/social/wechat-luojiagingwei.png')

// 友情链接数据
const friendLinks = [
  { name: "武汉大学", url: "https://www.whu.edu.cn/" },
  { name: "测绘遥感信息工程全国重点实验室", url: "https://liesmars.whu.edu.cn/" }
  // 未来可添加更多链接
];
---

<footer class="border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- 联系方式卡片 -->
    <div class="flex flex-col md:flex-row items-center md:items-start gap-6 md:gap-8">
      <div class="flex-1">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <a
            href="https://github.com/cveo"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 transition-colors group"
            title="访问GitHub仓库"
          >
            <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 group-hover:bg-slate-200 transition-colors">
              <Icon name="github" class="w-8 h-8" />
            </div>
            <div class="min-h-[3.5rem] flex flex-col justify-center">
              <p class="font-medium text-slate-900">GitHub</p>
              <p class="text-xs text-slate-600">访问团队开源代码仓库</p>
            </div>
          </a>

          <div class="relative footer-wrap" data-footer-card>
            <button
              type="button"
              class="footer-btn w-full text-left flex items-center gap-3 p-3 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 transition-colors"
              aria-expanded="false"
              aria-label="查看邮箱使用说明"
            >
              <span class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 group-hover:bg-slate-200 transition-colors">
                <Icon name="mail" class="w-8 h-8" />
              </span>
              <span class="min-h-[3.5rem] flex flex-col justify-center">
                <span class="font-medium text-slate-900">邮箱</span>
                <span class="text-xs text-slate-600 leading-tight">zxdlmars#whu.edu.cn</span>
                <span class="text-xs text-slate-600 leading-tight">cgz#whu.edu.cn</span>
              </span>
            </button>
            <div class="footer-pop absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 z-10">
              <div class="bg-white p-3 rounded-lg shadow-lg border border-slate-200 min-w-[200px]">
                <p class="text-xs text-slate-600">
                  请将邮箱地址中的 <code class="bg-slate-100 px-1 py-0.5 rounded text-brand-900">#</code>
                  手动替换为 <code class="bg-slate-100 px-1 py-0.5 rounded text-brand-900">@</code>
                </p>
              </div>
            </div>
          </div>

          <div class="relative footer-wrap" data-footer-card>
            <button
              type="button"
              class="footer-btn w-full text-left flex items-center gap-3 p-3 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 transition-colors"
              aria-expanded="false"
              aria-label="查看CVEO课题组微信公众号二维码"
            >
              <span class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 transition-colors">
                <Icon name="chat" class="w-8 h-8" />
              </span>
              <span class="min-h-[3.5rem] flex flex-col justify-center">
                <span class="font-medium text-slate-900">CVEO课题组</span>
                <span class="text-xs text-slate-600">扫码关注公众号</span>
              </span>
            </button>
            <div class="footer-pop absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 z-10">
              <div class="bg-white p-3 rounded-lg shadow-lg border border-slate-200">
                <p class="text-xs text-slate-600 mb-2 text-center">
                  扫码关注CVEO课题组
                </p>
                {cveoQr && (
                  <Image
                    src={cveoQr}
                    alt="CVEO课题组微信公众号二维码"
                    width="256"
                    height="256"
                    class="w-32 h-32 object-contain rounded-lg"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
            </div>
          </div>

          <div class="relative footer-wrap" data-footer-card>
            <button
              type="button"
              class="footer-btn w-full text-left flex items-center gap-3 p-3 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 transition-colors"
              aria-expanded="false"
              aria-label="查看珞珈经纬微信公众号二维码"
            >
              <span class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 transition-colors">
                <Icon name="chat" class="w-8 h-8" />
              </span>
              <span class="min-h-[3.5rem] flex flex-col justify-center">
                <span class="font-medium text-slate-900">珞珈经纬</span>
                <span class="text-xs text-slate-600">扫码关注公众号</span>
              </span>
            </button>
            <div class="footer-pop absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 z-10">
              <div class="bg-white p-3 rounded-lg shadow-lg border border-slate-200">
                <p class="text-xs text-slate-600 mb-2 text-center">
                  扫码关注珞珈经纬
                </p>
                {luojiaQr && (
                  <Image
                    src={luojiaQr}
                    alt="珞珈经纬微信公众号二维码"
                    width="256"
                    height="256"
                    class="w-32 h-32 object-contain rounded-lg"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 友情链接 -->
    <div class="my-8">
      <h3 class="text-sm font-medium text-slate-900 mb-3">友情链接</h3>
      <div class="flex flex-wrap gap-x-4 gap-y-2">
        {friendLinks.map(link => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-slate-600 hover:text-brand-900 hover:underline transition-colors duration-200"
          >
            {link.name}
          </a>
        ))}
      </div>
    </div>

    <!-- 版权信息和导航 -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 my-6">
      <p class="text-slate-600 text-sm text-left">
        武汉大学 CVEO 课题组 © {currentYear}
      </p>

      <div class="text-slate-600 text-sm text-right" id="footer-nav">
        <a href="/" class="hover:text-brand-900">首页</a>
        <span class="mx-2">·</span>
        <a href="/research" class="hover:text-brand-900">成果</a>
        <span class="mx-2">·</span>
        <a href="/software" class="hover:text-brand-900">软件</a>
        <span class="mx-2">·</span>
        <a href="/news" class="hover:text-brand-900">新闻</a>
        <span class="mx-2">·</span>
        <a href="/team" class="hover:text-brand-900">团队</a>
        <span class="mx-2">·</span>
        <a href="/research-projects" class="hover:text-brand-900">项目</a>
      </div>
    </div>
  </div>
</footer>
<style>
  /* 弹层默认隐藏；桌面端 hover 显示，触屏/键盘通过点击或聚焦（footer-pop-open）显示 */
  .footer-pop {
    display: none;
  }
  .footer-wrap:hover .footer-pop,
  .footer-wrap:focus-within .footer-pop,
  .footer-wrap.footer-pop-open .footer-pop {
    display: block;
  }
</style>
<script>
  function setupFooterPopovers() {
    const wraps = document.querySelectorAll<HTMLElement>('[data-footer-card]');

    const closeAll = (except?: HTMLElement) => {
      wraps.forEach(wrap => {
        if (wrap !== except) {
          wrap.classList.remove('footer-pop-open');
          wrap.querySelector('button')?.setAttribute('aria-expanded', 'false');
        }
      });
    };

    const toggle = (wrap: HTMLElement) => {
      const isOpen = wrap.classList.toggle('footer-pop-open');
      wrap.querySelector('button')?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (isOpen) closeAll(wrap);
    };

    wraps.forEach(wrap => {
      const btn = wrap.querySelector('button');
      btn?.addEventListener('click', () => toggle(wrap));
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.footer-pop')) return; // 弹层内部的点击（如长按二维码）不关闭
      if (!target.closest('[data-footer-card]')) {
        closeAll();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });
  }

  // Run on load
  setupFooterPopovers();
</script>
