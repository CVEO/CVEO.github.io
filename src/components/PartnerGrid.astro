---
import { Image } from 'astro:assets'
import { resolveImage } from '../lib/images'

interface Partner {
  name: string
  logo?: string
  website?: string
  description?: string
}

const { partners } = Astro.props as {
  partners: Partner[]
}
---
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
  {partners.map(partner => {
    const logo = resolveImage(partner.logo)
    const content = (
      <div class="flex flex-col h-full">
        <div class="w-full h-20 mb-2 flex items-center justify-center p-2 flex-shrink-0">
          {logo ? (
            <Image
              src={logo}
              alt={`${partner.name} logo`}
              class="max-h-full max-w-full object-contain"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="w-12 h-12 rounded-full bg-brand-50 flex items-center justify-center text-brand-900 group-hover:bg-brand-100 transition-colors duration-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
          )}
        </div>

        <div class="flex-1 min-h-[2.5rem] flex flex-col items-center justify-start w-full gap-1">
          <h3 class="text-sm font-medium text-slate-900 text-center line-clamp-2 group-hover:text-brand-900 transition-colors duration-300 leading-tight">
            {partner.name}
          </h3>
          {partner.description && (
            <p class="text-xs text-slate-500 text-center line-clamp-2 leading-snug">
              {partner.description}
            </p>
          )}
        </div>
      </div>
    )

    return partner.website ? (
      <a
        href={partner.website}
        target="_blank"
        rel="noopener noreferrer"
        class="group block p-3 rounded-lg border border-slate-200 bg-white hover:shadow-md hover:border-brand-200 transition-all duration-300 h-full"
        title={partner.name}
      >
        {content}
      </a>
    ) : (
      <div class="group p-3 rounded-lg border border-slate-200 bg-white h-full">
        {content}
      </div>
    )
  })}
</div>
