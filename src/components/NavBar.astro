---
import { Image } from 'astro:assets'
import { resolveImage } from '../lib/images'

const logo = resolveImage('/assets/logos/logo.png')
---
<header class="bg-white/75 backdrop-blur border-b border-slate-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <div class="flex items-center gap-4">
        <a href="/" class="flex items-center gap-3">
          {logo && (
            <Image
              src={logo}
              alt="CVEO课题组logo"
              width="80"
              height="80"
              class="h-10 w-10 rounded shadow-sm hover:shadow transition-shadow"
              loading="eager"
              decoding="async"
            />
          )}
          <span class="font-semibold text-brand-900 text-lg hidden md:inline">CVEO课题组</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-6 text-sm" id="main-nav" aria-label="主导航">
        <a href="/" class="text-slate-700 hover:text-brand-900 transition-colors">首页</a>
        <a href="/news" class="text-slate-700 hover:text-brand-900 transition-colors">新闻动态</a>
        <a href="/research" class="text-slate-700 hover:text-brand-900 transition-colors">科研成果</a>
        <a href="/team" class="text-slate-700 hover:text-brand-900 transition-colors">团队成员</a>
        <a href="/research-projects" class="text-slate-700 hover:text-brand-900 transition-colors">科研项目</a>
        <a href="/collaboration" class="text-slate-700 hover:text-brand-900 transition-colors">合作平台</a>
        <a href="/join" class="px-3 py-1.5 rounded-lg bg-brand-900 text-white hover:bg-brand-800 transition-colors font-medium">加入我们</a>
      </nav>

      <!-- Mobile Menu Button -->
      <button 
        type="button"
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg text-slate-700 hover:text-brand-900 hover:bg-slate-100 transition-colors"
        aria-label="打开菜单"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <nav 
      id="mobile-nav"
      class="hidden md:hidden py-4 border-t border-slate-200"
      aria-label="移动端导航"
    >
      <div class="flex flex-col space-y-2">
        <a href="/" class="px-3 py-2 rounded-lg text-slate-700 hover:text-brand-900 hover:bg-slate-50 transition-colors">首页</a>
        <a href="/news" class="px-3 py-2 rounded-lg text-slate-700 hover:text-brand-900 hover:bg-slate-50 transition-colors">新闻动态</a>
        <a href="/research" class="px-3 py-2 rounded-lg text-slate-700 hover:text-brand-900 hover:bg-slate-50 transition-colors">科研成果</a>
        <a href="/team" class="px-3 py-2 rounded-lg text-slate-700 hover:text-brand-900 hover:bg-slate-50 transition-colors">团队成员</a>
        <a href="/research-projects" class="px-3 py-2 rounded-lg text-slate-700 hover:text-brand-900 hover:bg-slate-50 transition-colors">科研项目</a>
        <a href="/collaboration" class="px-3 py-2 rounded-lg text-slate-700 hover:text-brand-900 hover:bg-slate-50 transition-colors">合作平台</a>
        <a href="/join" class="px-3 py-2 rounded-lg bg-brand-900 text-white hover:bg-brand-800 transition-colors font-medium text-center">加入我们</a>
      </div>
    </nav>
  </div>
</header>

<script>
  function setupNav() {
    const nav = document.getElementById('main-nav');
    const mobileNav = document.getElementById('mobile-nav');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const menuIconOpen = document.getElementById('menu-icon-open');
    const menuIconClose = document.getElementById('menu-icon-close');

    if (!nav || !mobileNav || !mobileMenuBtn) return;
    const mobileNavEl = mobileNav;
    const menuBtnEl = mobileMenuBtn;

    // Mobile menu toggle
    let isMenuOpen = false;

    function toggleMenu() {
      isMenuOpen = !isMenuOpen;
      mobileNavEl.classList.toggle('hidden', !isMenuOpen);
      menuIconOpen?.classList.toggle('hidden', isMenuOpen);
      menuIconClose?.classList.toggle('hidden', !isMenuOpen);
      menuBtnEl.setAttribute('aria-expanded', isMenuOpen.toString());
    }

    function closeMenu() {
      if (isMenuOpen) {
        isMenuOpen = false;
        mobileNavEl.classList.add('hidden');
        menuIconOpen?.classList.remove('hidden');
        menuIconClose?.classList.add('hidden');
        menuBtnEl.setAttribute('aria-expanded', 'false');
      }
    }

    menuBtnEl.addEventListener('click', toggleMenu);

    // Close menu when clicking on mobile nav links
    const mobileLinks = mobileNavEl.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as Node | null;
      if (!target || (!mobileNavEl.contains(target) && !menuBtnEl.contains(target))) {
        closeMenu();
      }
    });
  }

  // Run on load
  setupNav();
</script>
