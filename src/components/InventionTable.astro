---
import BaseTable from './PatentTable/BaseTable.astro';
import type { Patent } from '../lib/types';

interface Props {
  patents: Patent[];
  className?: string;
}

const {
  patents,
  className = ''
} = Astro.props;
---

<BaseTable
  patents={patents}
  className={className}
  id="invention-patent-table"
/>
