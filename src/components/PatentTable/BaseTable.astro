---
import type { Patent } from '../../lib/types';

interface Props {
  patents: Patent[];
  className?: string;
  id?: string;
  /** 按近五年/更早分组展示（适用于软件著作权等长期积累成果） */
  groupByRecent?: boolean;
}

const {
  patents,
  className = '',
  id = 'patent-table',
  groupByRecent = false
} = Astro.props;

const RECENT_YEARS = 5;

const typeBadge = (type: string) => {
  if (type === '发明专利') return 'bg-blue-50 text-blue-700 border-blue-200';
  if (type === '实用新型专利') return 'bg-green-50 text-green-700 border-green-200';
  return 'bg-purple-50 text-purple-700 border-purple-200';
};

const statusBadge = (status?: string) => {
  if (status === '已授权' || status === '已登记') return 'bg-green-50 text-green-700 border-green-200';
  return 'bg-amber-50 text-amber-800 border-amber-200';
};

const numberLabel = (patent: Patent) => {
  if (patent.status === '审查中' || patent.status === '申请中') return '申请号';
  if (patent.type === '软件著作权') return '登记号';
  if (/^CN/i.test(patent.patentNumber)) return '授权公告号';
  return '专利号';
};

const ownerLabel = (patent: Patent) =>
  patent.type === '软件著作权' ? '著作权人' : '发明人（单位）';

const currentYear = new Date().getFullYear();
const recentSince = currentYear - (RECENT_YEARS - 1);
const isRecent = (p: Patent) => {
  const y = parseInt((p.grantDate || '').slice(0, 4), 10);
  return Number.isFinite(y) && y >= recentSince;
};

const groups = groupByRecent
  ? [
      { label: `近五年（${recentSince} 年至今）`, items: patents.filter(isRecent) },
      { label: '更早', items: patents.filter(p => !isRecent(p)) }
    ].filter(group => group.items.length > 0)
  : [{ label: '', items: patents }];
---

<div class={className} id={id}>
  {groups.map((group) => (
    <section class={groupByRecent ? 'mb-10 last:mb-0' : ''}>
      {group.label && (
        <h3 class="text-lg font-semibold text-slate-900 mb-4">{group.label}</h3>
      )}
      <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
        {group.items.map((patent) => (
          <article class="p-4 rounded-lg border border-slate-200 bg-white hover:shadow-md transition">
            <div class="flex items-center justify-between gap-2 mb-2">
              <div class="flex flex-wrap items-center gap-2 min-w-0">
                <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border whitespace-nowrap ${typeBadge(patent.type)}`}>
                  {patent.type}
                </span>
                {patent.status && (
                  <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border whitespace-nowrap ${statusBadge(patent.status)}`}>
                    {patent.status}
                  </span>
                )}
              </div>
              {patent.grantDate && (
                <span class="text-xs text-slate-500 whitespace-nowrap shrink-0">{patent.grantDate}</span>
              )}
            </div>
            <h4 class="text-base font-semibold text-slate-900 leading-snug">{patent.title}</h4>
            <div class="mt-3 flex flex-col gap-1.5 text-sm">
              <p class="flex flex-wrap items-baseline gap-x-2">
                <span class="text-xs text-slate-500 whitespace-nowrap">{numberLabel(patent)}</span>
                <span class="font-mono text-slate-800 break-all">{patent.patentNumber}</span>
              </p>
              <p class="flex flex-wrap items-baseline gap-x-2">
                <span class="text-xs text-slate-500 whitespace-nowrap">{ownerLabel(patent)}</span>
                <span class="text-slate-700">{patent.inventors?.join('、') || '—'}</span>
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
</div>
