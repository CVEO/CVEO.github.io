---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Image } from 'astro:assets'
import { resolveImage } from '../lib/images'
import softwareData from '../data/software.json'

interface SoftwareImage {
  src: string;
  alt: string;
  caption?: string;
}

interface SoftwareTool {
  slug: string;
  name: string;
  tagline: string;
  status: string;
  distribution: string;
  highlights: string[];
  tags: string[];
  partners: string[];
  relatedPapers?: string[];
  award?: string;
  articleUrl?: string;
  usageNote?: string;
  images?: {
    hero?: SoftwareImage;
    showcase?: SoftwareImage[];
  };
}

const tools = (softwareData as SoftwareTool[]).filter(t => t.status === '已发布')

const statusBadge = (status: string) => {
  if (status === '已发布') return 'bg-brand-green-50 text-brand-green-900 border-brand-green-200'
  if (status === '内测') return 'bg-blue-50 text-blue-700 border-blue-200'
  return 'bg-amber-50 text-amber-800 border-amber-200'
}
---
<BaseLayout title="软件工具" description="武汉大学CVEO课题组自研软件工具：倾斜摄影三维模型修复、无人机视频三维重建、立体卫星三维地表生成等，学术成果的工程化落地。">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="text-3xl font-bold text-slate-900 mb-4">软件工具</h1>
      <p class="text-sm tracking-widest text-slate-500 uppercase mb-4">Software &amp; Tools</p>
      <p class="text-lg text-slate-600 max-w-3xl mx-auto">
        课题组自研的行业软件工具——把学术论文中的算法，做成工程中用得上的产品
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-6">
      {tools.map(tool => {
        const heroImg = resolveImage(tool.images?.hero?.src)
        return (
          <a
            href={`/software/${tool.slug}`}
            class="group flex flex-col w-full md:w-[calc(50%-12px)] xl:w-[calc(33.333%-16px)] max-w-md rounded-2xl border border-slate-200 bg-white overflow-hidden hover:shadow-lg hover:border-brand-200 transition-all duration-300"
          >
            <div class="aspect-[16/10] bg-slate-100 overflow-hidden">
              {heroImg && tool.images?.hero ? (
                <Image
                  src={heroImg}
                  alt={tool.images.hero.alt}
                  class="w-full h-full object-cover object-left-top group-hover:scale-[1.02] transition-transform duration-300"
                  widths={[480, 960]}
                  quality={92}
                  sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-slate-400 text-sm">界面截图整理中</div>
              )}
            </div>

            <div class="flex flex-col flex-1 p-5">
              <div class="flex items-start justify-between gap-3 mb-2">
                <h2 class="font-semibold text-lg text-slate-900 group-hover:text-brand-900 transition-colors leading-snug">{tool.name}</h2>
                <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border flex-shrink-0 ${statusBadge(tool.status)}`}>
                  {tool.status}
                </span>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed line-clamp-2 mb-4">{tool.tagline}</p>

              <ul class="space-y-1.5 mb-4">
                {tool.highlights.slice(0, 3).map(h => (
                  <li class="flex items-start gap-2 text-xs text-slate-600">
                    <svg class="w-3.5 h-3.5 text-brand-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span class="line-clamp-1">{h}</span>
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-1.5 mb-4">
                {tool.tags.map(tag => (
                  <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-brand-50 text-brand-900 border border-brand-100">{tag}</span>
                ))}
              </div>

              <div class="mt-auto flex items-center text-sm font-medium text-brand-900">
                查看详情
                <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            </div>
          </a>
        )
      })}
    </div>

    <!-- 底部 CTA -->
    <div class="mt-12 p-6 rounded-xl bg-gradient-to-br from-brand-50 to-white border border-brand-100 flex flex-col md:flex-row items-center justify-between gap-4">
      <div>
        <h3 class="font-semibold text-slate-900 mb-1">企业定制与软件合作</h3>
        <p class="text-sm text-slate-600">工具定制开发、联合研发、成果转化，欢迎与我们联系</p>
      </div>
      <a
        href="/collaboration"
        class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-brand-900 text-white hover:bg-brand-800 transition-colors font-medium flex-shrink-0"
      >
        了解合作方式
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
