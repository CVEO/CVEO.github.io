---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/icons/Icon.astro'
import PaperCard from '../components/PaperCard.astro'
import NewsCard from '../components/NewsCard.astro'
import ProjectCard from '../components/ProjectCard.astro'
import CollaborationEntryCards from '../components/CollaborationEntryCards.astro'
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import { loadNews, getLatestNews } from '../lib/data/news'
import { resolveImage } from '../lib/images'
import type { NewsItem } from '../lib/types'


import aboutData from '../data/about.json'
import researchProjectsData from '../data/research-projects.json'
import awardsData from '../data/awards.json'

const techAwards = awardsData.filter(a => a.type === 'tech')
const studentAwards = awardsData
  .filter(a => a.type === 'student')
  .sort((a, b) => Number(b.year) - Number(a.year))

const teamPhoto = resolveImage('/assets/avatars/team.jpg')

const papers = await getCollection('papers') || []
const ourPapers = papers.filter(p => p.id.startsWith('our/'))
const featuredPapers = ourPapers
  .filter(p => p.data.featured)
  .sort((a,b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
const recentPapers = featuredPapers.slice(0, 5)



// 加载新闻数据
const allNews = await loadNews()
const newsItems = getLatestNews(allNews, 3)


---
<BaseLayout>
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="text-center">
        <h1 class="text-3xl sm:text-5xl font-bold text-brand-900 mb-4 py-4">武汉大学 CVEO 课题组</h1>
        <p class="text-xl text-slate-700 mb-2">计算机视觉与地球观测交叉研究团队</p>
        <p class="text-sm tracking-widest text-slate-500 uppercase mb-5">Computer Vision for Earth Observation · Wuhan University</p>
        <div class="inline-flex items-center space-x-2 text-slate-600">
          <Icon name="map-pin" class="w-5 h-5" />
          <span>{aboutData.affiliation}</span>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 scroll-mt-16">
    <!-- <h2 class="text-3xl font-bold text-slate-900 mb-6 flex items-center">
      关于课题组
    </h2> -->
    
    <div class="space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="p-5 rounded-xl bg-gradient-to-br from-brand-50 to-white border border-brand-100 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-900 mb-3">关于我们</h3>
          <div class="text-slate-700 leading-relaxed text-justify space-y-3">
            {aboutData.introduction.split('\n\n').map(para => (
              <p set:html={para} />
            ))}
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-3">
          {(aboutData.stats || []).map(stat => (
            <div class="p-4 rounded-lg bg-white border border-slate-200 hover:border-brand-200 hover:shadow-md transition-all duration-300">
              <div class="text-2xl font-semibold text-brand-900 mb-1">{stat.value}<span class="text-sm ml-1 font-normal text-slate-500">{stat.unit}</span></div>
              <div class="text-sm text-slate-600 font-medium">{stat.label}</div>
            </div>
          ))}
        </div>
       </div>

      <section id="team" class="max-w-7xl mx-auto  scroll-mt-16">
              <div class="rounded-2xl overflow-hidden shadow-xl border border-slate-200">
        {teamPhoto && (
          <Image
            src={teamPhoto}
            alt="CVEO课题组团队合影"
            class="w-full h-auto object-cover"
            widths={[640, 1024, 1600]}
            sizes="(max-width: 1280px) 100vw, 1152px"
            loading="eager"
            decoding="async"
            format="webp"
          />
        )}
      </div>
    <div class="text-center">
      <p class="text-slate-600 mb-2 max-w-2xl mx-auto py-4">
        武汉大学CVEO课题组汇聚了来自计算机视觉与地球观测交叉领域的优秀研究人员
      </p>
      <a href="/team" class="inline-flex items-center justify-center px-6 py-3 mb-3 rounded-lg border-2 border-brand-900 text-brand-900 hover:bg-brand-50 hover:border-brand-800 active:bg-brand-100 active:scale-95 transition-all duration-200 font-medium text-base min-h-[44px] min-w-[120px]">
        查看完整团队成员
        <Icon name="arrow-right" class="w-5 h-5 ml-2" />
      </a>
    </div>
  </section>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="p-5 rounded-xl bg-gradient-to-br from-brand-green-50 to-white border border-brand-green-100 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-lg font-semibold text-slate-900">核心研究领域</h3>
            <a
              href="/research/#kg-graph"
              class="inline-flex items-center text-sm font-medium text-brand-900 hover:text-brand-700 group"
              title="查看研究成果知识图谱"
            >
              研究图谱
              <svg class="w-4 h-4 ml-0.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
          <div class="space-y-3">
            {(aboutData.researchFields || []).map(field => (
              <div class="flex items-start group">
                <div class="flex-shrink-0 w-9 h-9 rounded-lg bg-brand-green-100 flex items-center justify-center mr-3 group-hover:bg-brand-green-200 transition-colors duration-300">
                  <Icon name="check" class="w-4 h-4" />
                </div>
                <div>
                  <h4 class="font-semibold text-slate-900 group-hover:text-brand-green-900 transition-colors duration-300">{field.title}</h4>
                  <p class="text-sm text-slate-600 mt-1">{field.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <div class="p-5 rounded-xl bg-gradient-to-br from-slate-50 to-white border border-slate-200">
          <h3 class="text-lg font-semibold text-slate-900 mb-3">团队特色</h3>
          <div class="space-y-3">
            <div class="flex items-start">
              <div class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-100 flex items-center justify-center mr-3">
                <Icon name="check-circle" class="w-3.5 h-3.5" />
              </div>
              <div>
                <h4 class="font-medium text-slate-900">产学研结合</h4>
                <p class="text-sm text-slate-600 mt-1">理论研究与产业应用紧密结合，推动科技成果转化</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-100 flex items-center justify-center mr-3">
                <Icon name="users" class="w-3.5 h-3.5" />
              </div>
              <div>
                <h4 class="font-medium text-slate-900">国际化视野</h4>
                <p class="text-sm text-slate-600 mt-1">聚焦全球学术前沿，致力于开展高水平创新研究</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="flex-shrink-0 w-7 h-7 rounded-full bg-brand-100 flex items-center justify-center mr-3">
                <Icon name="bolt" class="w-3.5 h-3.5" />
              </div>
              <div>
                <h4 class="font-medium text-slate-900">创新驱动</h4>
                <p class="text-sm text-slate-600 mt-1">鼓励学生探索前沿技术，培养创新思维</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 招生信息卡片 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 scroll-mt-16">
    <div class="p-6 rounded-xl bg-gradient-to-br from-brand-50 to-white border border-brand-100 shadow-sm hover:shadow-md transition-all duration-300">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-brand-900 flex items-center justify-center">
              <Icon name="graduation-cap" class="w-6 h-6 text-white" />
            </div>
            <h2 class="text-2xl font-semibold text-slate-900">加入我们</h2>
          </div>
          <p class="text-slate-600 mb-4">
            招收武汉大学本科生（日常科研、大创）、硕士研究生、博士研究生；
            同时与长江大学、三峡大学合作招收硕士研究生。
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-sm font-medium bg-brand-100 text-brand-900">武汉大学</span>
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-sm font-medium bg-brand-green-100 text-brand-green-900">长江大学</span>
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-sm font-medium bg-brand-green-100 text-brand-green-900">三峡大学</span>
          </div>
        </div>
        <a 
          href="/join" 
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-brand-900 text-white hover:bg-brand-800 transition-colors font-medium min-w-[140px]"
        >
          了解详情
          <Icon name="arrow-right" class="w-5 h-5 ml-2" />
        </a>
      </div>
    </div>
  </section>

  <section id="news" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 scroll-mt-16">
    <h2 class="text-2xl font-semibold text-slate-900 mb-8">新闻动态</h2>
    
    <div class="space-y-6">
      {(newsItems || []).map((news: NewsItem) => (
        <NewsCard 
          news={news}
          layout="horizontal"
          showImage={true}
          showDescription={true}
          showDate={true}
        />
      ))}
    </div>
    
    <div class="mt-8 text-center">
      <a href="/news" class="inline-flex items-center justify-center px-6 py-3 rounded-lg border-2 border-brand-900 text-brand-900 hover:bg-brand-50 hover:border-brand-800 active:bg-brand-100 active:scale-95 transition-all duration-200 font-medium text-base min-h-[44px] min-w-[120px]">
        查看全部动态
        <Icon name="arrow-right" class="w-5 h-5 ml-2" />
      </a>
    </div>
  </section>

  <section id="research" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 scroll-mt-16">
    <h2 class="text-2xl font-semibold text-slate-900 mb-8">科研成果</h2>
    
    <div>
      <h3 class="text-xl font-semibold text-slate-900 mb-6">代表论文</h3>    
       <div class="grid grid-cols-1 gap-6">
        {(recentPapers || []).map(p => (
          <PaperCard paper={p} showAbstract={false} showLink={true} />
        ))}
      </div>
      <div class="mt-8 text-center">
        <a href="/research" class="inline-flex items-center justify-center px-6 py-3 rounded-lg border-2 border-brand-900 text-brand-900 hover:bg-brand-50 hover:border-brand-800 active:bg-brand-100 active:scale-95 transition-all duration-200 font-medium text-base min-h-[44px] min-w-[120px]">
          查看更多科研成果
          <Icon name="arrow-right" class="w-5 h-5 ml-2" />
        </a>
      </div>
    </div>
  </section>

  

  <section id="projects" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 scroll-mt-16">
    <h2 class="text-2xl font-semibold text-slate-900 mb-8">科研项目</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {researchProjectsData
        .filter(project => project.status === '在研')
        .slice(0, 6)
        .map(project => (
        <ProjectCard project={project} />
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="/research-projects" class="inline-flex items-center justify-center px-6 py-3 rounded-lg border-2 border-brand-900 text-brand-900 hover:bg-brand-50 hover:border-brand-800 active:bg-brand-100 active:scale-95 transition-all duration-200 font-medium text-base min-h-[44px] min-w-[120px]">
        查看全部科研项目
        <Icon name="arrow-right" class="w-5 h-5 ml-2" />
      </a>
    </div>
  </section>

  <section id="awards" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 scroll-mt-16">
    <h2 class="text-2xl font-semibold text-slate-900 mb-2">荣誉奖项</h2>
    <p class="text-slate-500 mb-8">科技奖励与学生竞赛累计 <span class="font-medium text-brand-900">{awardsData.length}</span> 项</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- 科技奖励 -->
      <div class="p-6 rounded-xl bg-gradient-to-br from-brand-50 to-white border border-brand-100">
        <div class="flex items-center justify-between mb-5">
          <h3 class="text-lg font-semibold text-slate-900">科技奖励</h3>
          <span class="text-xs text-slate-500">Science & Tech Awards · {techAwards.length} 项</span>
        </div>
        <div class="space-y-4">
          {techAwards.map(award => (
            <div class="flex items-start p-4 rounded-xl border border-slate-200 bg-white hover:shadow-md transition">
              <div class="w-10 h-10 rounded-full bg-brand-50 flex items-center justify-center mr-4 flex-shrink-0">
                <Icon name="trophy" class="w-5 h-5 text-brand-900" />
              </div>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={`inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold ${award.prize === '特等奖' ? 'bg-brand-900 text-white' : award.prize.includes('二等') ? 'bg-brand-600 text-white' : 'bg-brand-200 text-brand-900'}`}>{award.prize}</span>
                  <span class="text-xs text-slate-500">{award.awardName} · {award.year}</span>
                </div>
                <p class="text-sm font-medium text-slate-800 mt-1.5 leading-snug">{award.project}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- 学生竞赛 -->
      <div class="p-6 rounded-xl bg-gradient-to-br from-brand-green-50 to-white border border-brand-green-100">
        <div class="flex items-center justify-between mb-5">
          <h3 class="text-lg font-semibold text-slate-900">学生竞赛</h3>
          <span class="text-xs text-slate-500">Student Competitions · {studentAwards.length} 项</span>
        </div>
        <ol class="relative border-l-2 border-brand-green-200 ml-3 space-y-4">
          {studentAwards.map(award => (
            <li class="ml-5">
              <span class="absolute -left-[7px] w-3 h-3 rounded-full bg-brand-green-500 border-2 border-white"></span>
              <div class="flex flex-wrap items-baseline gap-x-2">
                <span class="text-sm font-bold text-brand-green-900">{award.year}</span>
                <span class="text-sm font-medium text-slate-800">{award.awardName}</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-brand-green-100 text-brand-green-900">{award.prize}</span>
                {award.mentor && (
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs bg-white border border-brand-green-200 text-brand-green-900">{award.mentor}</span>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {aboutData.collaborationCards && aboutData.collaborationCards.length > 0 && (
    <CollaborationEntryCards cards={aboutData.collaborationCards} />
  )}
</BaseLayout>

